# ==============================================================================
# BUNNY AI — Frontend Environment Configuration Example
# ==============================================================================

# Supabase Client Configuration (Public Anon Key only)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API Endpoint URL
# Use http://localhost:5000 for local development, or your production backend domain
BACKEND_URL=http://localhost:5000
