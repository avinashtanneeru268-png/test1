# ==============================================================================
# Comprehensive .gitignore for Gemini Chatbot & Full-Stack Node.js Application
# Prevents sensitive API keys, database credentials, logs, and build artifacts
# from being committed to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & API Keys (CRITICAL)
# ------------------------------------------------------------------------------
# Ignore all .env files anywhere in the repository
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Specific folder .env references
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Explicitly ALLOW example/template files to be committed safely
!.env.example
!backend/.env.example
!frontend/.env.example

# Secret keys, certificates and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
credentials.json
serviceAccountKey.json
secrets/

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
jspm_packages/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 3. Logs & Process Artifacts
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------------------------------------------
# 4. Operating System Junk & Caches
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & Developer Tools
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# AI Agent & Assistant scratch spaces
.gemini/
.agents/
.antigravity/

# ------------------------------------------------------------------------------
# 6. Build Outputs, Caches & Temporary Files
# ------------------------------------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.eslintcache/
temp/
tmp/
scratch/
*.tmp
*.bak
