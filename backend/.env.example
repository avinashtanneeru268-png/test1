# ==============================================================================
# BUNNY AI — Backend Environment Configuration Example
# Copy this file to '.env' and fill in your values.
# NEVER commit your real '.env' file containing real secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI API Credentials
# Obtain your API key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# Primary text generation model (default: gpt-6-luna)
OPENAI_MODEL=gpt-6-luna

# Verified fallback model in case primary model is not enabled on account
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Optional Audio Configuration (Whisper STT & TTS)
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# ------------------------------------------------------------------------------
# 2. Server Port
# ------------------------------------------------------------------------------
PORT=5000

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database (Optional but recommended for sync)
# Obtain Project URL and Keys from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key is only for server-side privileged tasks; optional for standard demo
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: PostgreSQL Direct Connection for CLI migrations ('npm run migrate')
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
